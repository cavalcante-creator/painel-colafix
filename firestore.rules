rules_version = '2';
// Regras do banco do Painel de Operação Colafix (versão online, login por usuário e senha).
// - Dona do painel (usuário iasmyn): tudo, inclusive criar contas e liberar acessos.
// - Pessoas liberadas em Ajustes → Equipe e cargos: leem e gravam o operacional
//   (o que cada uma vê é decidido pelo cargo; o ajuste por pessoa pode bloquear gravação em coleções: bloqCols).
// - Cargos só de ver (Telas de TV, TV da fábrica, Calendário, Silos só consulta, Silos e calendário): leem e não gravam nada.
// - QR da linha, sem login: o celular (sem conta) só consegue CRIAR um chamado novo e a foto dele
//   (não lê nada do painel). O painel da manutenção transforma o chamado em OS numerada.
// - Conta criada e ainda não liberada: só registra o próprio pedido e o próprio nome.
// Para publicar: Firebase → Firestore Database → Regras → apagar tudo, colar este texto → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function provedor() { return request.auth.token.firebase.sign_in_provider; }
    // QR sem login: celular sem conta (ou anônimo, se o login anônimo estiver ligado)
    function semConta() { return request.auth == null || provedor() == 'anonymous'; }
    function dono() { return logado() && request.auth.token.email == 'iasmyn@painel-colafix.app'; }
    function caminhoAcs() { return /databases/$(database)/documents/acessos/$(request.auth.uid); }
    function acs() { return get(caminhoAcs()).data; }
    function liberado() {
      return logado() && provedor() != 'anonymous' && exists(caminhoAcs())
        && acs().get('ativo', true) != false && acs().get('apagado', false) != true;
    }
    function soVer() { return acs().get('perfil', '') in ['ver', 'tv', 'cal', 'silosver', 'consulta', 'tvtodas', 'rh', 'producao', 'auditor', 'tvman']; } // consultas e TVs não gravam (revisão de acessos)
    function le() { return dono() || liberado(); }
    function grava() { return dono() || (liberado() && !soVer()); }
    // Ajuste por pessoa (Equipe e cargos → Ajustar acesso): coleções em que ela não pode gravar (ex.: módulo "só ver").
    // RH: dados dos funcionários (CPF etc.) — só a dona e quem tem o módulo RH (no cargo ou como extra).
    function rhOk() { return dono() || (liberado() && (acs().get('mods', []).hasAny(['rh']) || acs().get('extras', []).hasAny(['rh']))); }
    function bloq(c) { return !dono() && c in acs().get('bloqCols', []); }

    // Tudo o que é operacional (ordens, entregas, paradas, ranchos, almox, premix, chamados, config...)
    match /{col}/{id} {
      allow read: if le() && !(col in ['acessos', 'pedidos', 'perfis', 'silomov', 'crachas', 'rh', 'presenca', 'gxquadro', 'melhorias', 'horaextra', 'frota']);
      allow write: if grava() && !bloq(col) && !(col in ['acessos', 'pedidos', 'perfis', 'silomov', 'crachas', 'rh', 'presenca', 'gxquadro', 'melhorias', 'horaextra', 'frota']);
    }
    match /{col}/{id}/{resto=**} {
      allow read: if le() && !(col in ['acessos', 'pedidos', 'perfis', 'silomov', 'crachas', 'rh', 'presenca', 'gxquadro', 'melhorias', 'horaextra', 'frota']);
      allow write: if grava() && !bloq(col) && !(col in ['acessos', 'pedidos', 'perfis', 'silomov', 'crachas', 'rh', 'presenca', 'gxquadro', 'melhorias', 'horaextra', 'frota']);
    }

    // Silos: histórico do saldo (consumo, estorno, medição). Só inclusão: ninguém altera nem apaga uma movimentação.
    // O saldo atual fica em silos/{id} (regra geral acima: lê quem é liberado, grava quem pode gravar).
    match /silomov/{id} {
      allow read: if le();
      // a dona também cria (importar a cópia de segurança num projeto novo traz o histórico com os usuários antigos)
      allow create: if dono() || grava() && !bloq('silomov') && request.resource.data.porUid == request.auth.uid
        && request.resource.data.tipo in ['consumo', 'estorno', 'medicao', 'recusado', 'entrada']; // entrada = recebimento pela nota
      allow update, delete: if false;
    }

    // Crachás dos funcionários (QR = só um código). O tablet da parede lê; só a dona do painel cria, desativa ou troca o código.
    match /crachas/{id} {
      allow read: if le();
      allow write: if dono();
    }

    // QR da folha de produção (rancho), sem login: só CRIA o aviso de recebimento, com campos limitados.
    // Quem é liberado lê e marca como aplicado (regra geral acima).
    match /rancrec/{id} {
      allow create: if (semConta() || logado()) && id.matches('r-[0-9]+-[a-z0-9]+')
        && request.resource.data.keys().hasOnly(['rancho', 'nome', 'em', 'status', 'origem'])
        && request.resource.data.rancho is string && request.resource.data.rancho.matches('[0-9]{4,12}')
        && request.resource.data.nome is string && request.resource.data.nome.size() > 1 && request.resource.data.nome.size() <= 60
        && request.resource.data.status == 'novo' && request.resource.data.origem == 'qr';
    }

    // Módulo RH: funcionários, funções (EPI/uniforme), retiradas, arquivos das fichas.
    match /rh/{resto=**} {
      allow read, write: if rhOk();
    }
    // Entregas de uniforme (29/10): quem tem a Visão do gestor (Marcelo) só LÊ, para ver o relatório de quem pegou.
    match /rh/dados/uniformes/{id} {
      allow read: if liberado() && (acs().get('mods', []).hasAny(['gestor']) || acs().get('extras', []).hasAny(['gestor']));
    }

    // Ficha de admissão pelo celular (ficha.html?c=CÓDIGO, sem login): o RH cria o convite (código de 20 letras e números);
    // a pessoa só lê o próprio convite e só CRIA a ficha e as fotos, uma vez, enquanto o convite vale. Não lê nada do RH.
    match /rh/dados/convites/{t} {
      allow get: if true;
    }
    match /rh/dados/fichascand/{t} {
      allow create: if (semConta() || logado()) && t.matches('[a-z0-9]{20}')
        && exists(/databases/$(database)/documents/rh/dados/convites/$(t))
        && get(/databases/$(database)/documents/rh/dados/convites/$(t)).data.get('usado', false) != true
        && request.time.toMillis() < get(/databases/$(database)/documents/rh/dados/convites/$(t)).data.get('ateMs', 0)
        && request.resource.data.keys().hasOnly(['nome', 'cpf', 'nascimento', 'telefone', 'email', 'cep', 'rua', 'numero', 'complemento', 'bairro', 'cidade',
             'camisa', 'calca', 'calcado', 'banco', 'agencia', 'conta', 'pix', 'emergNome', 'emergTel', 'obs', 'fotos', 'em',
             'tipo', 'horario', 'escolaridade', 'experiencia'])
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 80
        // ficha de admissão: CPF obrigatório; link de entrevista (tipo 'ent', 03/11): sem CPF
        && request.resource.data.cpf is string
        && (request.resource.data.cpf.matches('[0-9]{11}')
            || (request.resource.data.get('tipo', '') == 'ent' && request.resource.data.cpf == ''
                && get(/databases/$(database)/documents/rh/dados/convites/$(t)).data.get('tipo', '') == 'ent'))
        && request.resource.data.get('experiencia', '') is string && request.resource.data.get('experiencia', '').size() <= 600
        && request.resource.data.get('obs', '') is string && request.resource.data.get('obs', '').size() <= 400;
    }
    match /rh/dados/fichascandarq/{id} {
      allow create: if (semConta() || logado())
        && request.resource.data.keys().hasOnly(['c', 'n', 'nome', 'tipo', 'd', 'em'])
        && request.resource.data.c is string && request.resource.data.c.matches('[a-z0-9]{20}')
        && id.matches(request.resource.data.c + '-[0-9]{1,2}')
        && exists(/databases/$(database)/documents/rh/dados/convites/$(request.resource.data.c))
        && !exists(/databases/$(database)/documents/rh/dados/fichascand/$(request.resource.data.c))
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 60
        && request.resource.data.d is string && request.resource.data.d.size() < 900000;
    }

    // Pedido de nota fiscal do PJ (04/11, nota.html?c=CÓDIGO, sem login): o RH cria o pedido (código de 20 letras e números);
    // o PJ só lê o próprio pedido e só CRIA o envio da nota, uma vez, enquanto o pedido vale. Não lê nada do RH.
    match /rh/dados/pjnotaped/{t} {
      allow get: if true;
    }
    match /rh/dados/pjnotaenv/{t} {
      allow create: if (semConta() || logado()) && t.matches('[a-z0-9]{20}')
        && exists(/databases/$(database)/documents/rh/dados/pjnotaped/$(t))
        && get(/databases/$(database)/documents/rh/dados/pjnotaped/$(t)).data.get('usado', false) != true
        && request.time.toMillis() < get(/databases/$(database)/documents/rh/dados/pjnotaped/$(t)).data.get('ateMs', 0)
        && request.resource.data.keys().hasOnly(['pid', 'fid', 'nome', 'num', 'valor', 'obs', 'n', 'tipo', 'd', 'em'])
        && request.resource.data.pid == get(/databases/$(database)/documents/rh/dados/pjnotaped/$(t)).data.pid
        && request.resource.data.fid == get(/databases/$(database)/documents/rh/dados/pjnotaped/$(t)).data.fid
        && request.resource.data.get('num', '') is string && request.resource.data.get('num', '').size() <= 40
        && request.resource.data.get('obs', '') is string && request.resource.data.get('obs', '').size() <= 400
        && request.resource.data.get('n', '') is string && request.resource.data.get('n', '').size() <= 120
        && request.resource.data.d is string && request.resource.data.d.size() > 10 && request.resource.data.d.size() < 950000;
    }

    // Assinar pelo gov.br (04/11, assinar.html?c=CÓDIGO, sem login): o RH cria o pedido e o PDF em pedaços; quem tem o
    // código só lê o próprio pedido/PDF e só CRIA o arquivo assinado (pedaços primeiro, depois o envio), uma vez,
    // enquanto o pedido vale. Não lê nada do RH.
    function asnPed(t) { return get(/databases/$(database)/documents/rh/dados/assinped/$(t)).data; }
    function asnVale(t) { return exists(/databases/$(database)/documents/rh/dados/assinped/$(t))
      && asnPed(t).get('usado', false) != true && request.time.toMillis() < asnPed(t).get('ateMs', 0)
      && !exists(/databases/$(database)/documents/rh/dados/assinenv/$(t)); }
    match /rh/dados/assinped/{t} {
      allow get: if true;
    }
    match /rh/dados/assinpdf/{p} {
      allow get: if true;
    }
    match /rh/dados/assinenvp/{p} {
      allow create: if (semConta() || logado()) && p.matches('[a-z0-9]{20}-[0-9]{1,2}')
        && asnVale(p.split('-')[0])
        && request.resource.data.keys().hasOnly(['d'])
        && request.resource.data.d is string && request.resource.data.d.size() > 0 && request.resource.data.d.size() < 900000;
    }
    match /rh/dados/assinenv/{t} {
      allow create: if (semConta() || logado()) && t.matches('[a-z0-9]{20}') && asnVale(t)
        && request.resource.data.keys().hasOnly(['n', 'tam', 'partes', 'em', 'ver'])
        && request.resource.data.partes is int && request.resource.data.partes >= 1 && request.resource.data.partes <= 12
        && request.resource.data.get('n', '') is string && request.resource.data.get('n', '').size() <= 160
        && request.resource.data.get('ver', {}) is map;
    }

    // Chamado pelo QR da linha (sem login): só cria, com os campos do chamado.
    match /chamados/{id} {
      allow create: if semConta() && id.matches('q-[a-z0-9]+')
        && request.resource.data.keys().hasOnly(['linha', 'quando', 'defeito', 'impacto', 'nome', 'equip', 'equipId', 'foto', 'status', 'criado', 'por', 'numero', 'qr', 'qid', 'origem'])
        && request.resource.data.status == 'Aberta' && request.resource.data.numero == 999999 && request.resource.data.qr == true
        && request.resource.data.qid == id && request.resource.data.origem == 'qr'
        && request.resource.data.impacto in ['parou', 'reduziu', 'nao']
        && request.resource.data.defeito is string && request.resource.data.defeito.size() > 0 && request.resource.data.defeito.size() <= 900
        && request.resource.data.linha is string && request.resource.data.linha.size() > 0 && request.resource.data.linha.size() < 60
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 60;
    }

    // Foto do chamado mandada pelo QR (sem login): só cria, até ~750 KB.
    match /chamfotos/{id} {
      allow create: if semConta() && id.matches('f-[a-z0-9]+')
        && request.resource.data.keys().hasOnly(['d', 'em', 'origem']) && request.resource.data.d is string
        && request.resource.data.d.size() < 760000;
    }

    // Calendário de feriados (RH + produção): todos os liberados leem (regra geral); o RH também grava.
    // Presença do dia pelo Face ID (resumo SEM CPF, 22/10): o RH (ou a administradora) grava; lê quem tem o RH ou a Visão do gestor
    // Frota (11/11/2026): caminhões, motoristas (nomes), abastecimentos, tanque de diesel e manutenções. Só a dona e quem tem o módulo Frota.
    function frotaOk() { return dono() || (liberado() && (acs().get('mods', []).hasAny(['frota']) || acs().get('extras', []).hasAny(['frota']))); }
    match /frota/{resto=**} {
      allow read: if frotaOk();
      allow write: if frotaOk() && (dono() || !soVer());
    }
    match /presenca/{dia} {
      allow read: if rhOk() || (liberado() && (acs().get('mods', []).hasAny(['gestor']) || acs().get('extras', []).hasAny(['gestor'])));
      allow write: if rhOk();
    }
    // Hora extra (nomes e horas, 29/10 · LGPD): só quem tem a Visão do gestor (autoriza) e o RH (fechamento da folha) — antes todos os liberados liam.
    function gestorOk() { return liberado() && (acs().get('mods', []).hasAny(['gestor']) || acs().get('extras', []).hasAny(['gestor'])); }
    match /horaextra/{id} {
      allow read: if dono() || rhOk() || gestorOk();
      allow write: if dono() || (gestorOk() && !soVer());
    }
    // Pedidos de ajuste (29/10 · LGPD; 30/10: todo login pode pedir). Têm foto da tela, que pode mostrar dados do RH:
    // a administradora lê e mexe em todos; os outros só criam o próprio (aberto) e leem os próprios.
    match /melhorias/{id} {
      allow read: if dono() || (liberado() && resource.data.por == request.auth.uid);
      allow create: if dono() || (liberado() && request.resource.data.por == request.auth.uid
        && request.resource.data.status == 'aberto' && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000);
      allow update, delete: if dono();
    }
    // Quadro de pessoas do gestor (27/10: quem fica e quem sai, por linha/setor): só a dona e quem tem a Visão do gestor.
    match /gxquadro/{id} {
      allow read, write: if dono() || (liberado() && (acs().get('mods', []).hasAny(['gestor']) || acs().get('extras', []).hasAny(['gestor'])));
    }
    match /config/feriados {
      allow write: if rhOk();
    }

    // Lista de equipamentos da manutenção: o formulário do QR mostra os da linha.
    match /config/manut {
      allow get: if true;
    }

    // Acessos: só a dona libera ou muda; cada pessoa lê o próprio.
    match /acessos/{uid} {
      allow read: if dono() || (logado() && request.auth.uid == uid);
      allow write: if dono();
    }

    // Pedido de acesso (criado pela própria pessoa).
    match /pedidos/{uid} {
      allow read: if dono() || (logado() && request.auth.uid == uid);
      allow create, update: if dono() || (logado() && provedor() != 'anonymous' && request.auth.uid == uid);
      allow delete: if dono();
    }

    // Nome de cada pessoa (aparece nos históricos).
    match /perfis/{uid} {
      // 29/10 (LGPD): os nomes só para quem já foi liberado (ou o próprio perfil); conta criada e não liberada não lista ninguém
      allow read: if le() || (logado() && request.auth.uid == uid);
      allow write: if dono() || (logado() && provedor() != 'anonymous' && request.auth.uid == uid);
    }
  }
}
